# Copy this file to .env and replace every CHANGE_ME value.
DB_USER=chatwave
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_DATABASE=postgres
DB_SCHEMA=chatwave
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
JWT_SECRET_KEY=CHANGE_ME_TO_AT_LEAST_64_RANDOM_CHARACTERS
API_CORS_ALLOW_ORIGINS=["https://chat.example.com"]
MEDIA_FOLDER=/app/data

# The HTTP compose file exposes the API on loopback by default.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000

MAX_UPLOAD_IMAGE_SIZE=20
MAX_UPLOAD_VIDEO_SIZE=256
MAX_UPLOAD_AUDIO_SIZE=64
MAX_UPLOAD_FILE_SIZE=128
MAX_REQUEST_BODY_SIZE_MB=260
MAX_ARCHIVE_SIZE_MB=200
MAX_BULK_DOWNLOAD_SIZE_MB=512
MAX_MEDIA_STORAGE_PER_USER_MB=2048
MAX_ITEMS_PER_REQUEST=100
RATE_LIMIT_REQUESTS_PER_MINUTE=300
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_SIGNUP_PER_HOUR=5
RATE_LIMIT_WEBSOCKET_HANDSHAKES_PER_MINUTE=30
MAX_WEBSOCKETS_PER_USER=5
MAX_UNREAD_PAGE_SIZE=100

# TURN REST credentials are generated per authenticated user.
TURN_SHARED_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
TURN_URLS=["turn:turn.example.com:3478?transport=udp","turn:turn.example.com:3478?transport=tcp"]
STUN_URLS=["stun:turn.example.com:3478"]
TURN_CREDENTIAL_TTL_SECONDS=3600
TURN_REALM=turn.example.com
TURN_EXTERNAL_IP=203.0.113.10
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
